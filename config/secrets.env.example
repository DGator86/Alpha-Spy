# Alpha-SPY runtime secrets / deployment switches.
# Copy to /etc/alpha-spy/secrets.env on the VPS, chmod 600, and insert real values there.
# NEVER commit the real secrets.env file.

# Production Tradier credential used ONLY for real-time market data and websocket sessions.
TRADIER_MARKET_ACCESS_TOKEN=
TRADIER_STREAM_ENABLED=true

# Tradier sandbox credential/account used ONLY for paper order execution and reconciliation.
TRADIER_EXECUTION_ENVIRONMENT=sandbox
TRADIER_EXECUTION_ACCESS_TOKEN=
TRADIER_EXECUTION_ACCOUNT_ID=

# Paper broker execution: submit actual orders to the Tradier virtual account.
ALPHA_SPY_TRADING_ENABLED=true
ALPHA_SPY_SUBMIT_ORDERS=true
ALPHA_SPY_PAPER_MODE=true

# Dashboard tokens remain local/operator secrets.
ALPHA_SPY_VIEW_TOKEN=
ALPHA_SPY_ADMIN_TOKEN=
ALPHA_SPY_INGEST_TOKEN=
