# Python build output
build/
dist/
*.egg-info/
src/*.egg-info/
__pycache__/
*.py[cod]
.venv/
venv/
*.whl

# Test and lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# scripts/build_release.sh writes archives to dist/release/ (already ignored
# above). The committed release/ directory holds archived upstream drops.

# Research driver output (examples/ write REPORT.md and CSVs here by default)
reports/

# Local operator state — never commit tokens or live configuration
.env
.env.*
!.env.example
secrets.env
config/secrets.env
*.sqlite
*.sqlite3
*.db

# Frontend build inputs. The compiled workstation bundle under
# src/alpha_spy/dashboard/static/ IS committed — the wheel ships it so a
# trading VPS never needs Node — but its dependencies and caches are not.
frontend/node_modules/
frontend/tsconfig.tsbuildinfo
frontend/dist-preview/
