[Unit]
Description=SPY Constituent Alpha T+15 confirmation and audit tape
Wants=spy-der-market.service
After=spy-der-market.service
PartOf=spy-der.target

[Service]
Type=simple
User=spyder
Group=spyder
EnvironmentFile=-/etc/spy-der/secrets.env
ExecStart=/opt/spy-der/venv/bin/spy-der --config /etc/spy-der/config.yaml confirmation
Restart=always
RestartSec=5
Nice=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/spy-der /var/log/spy-der
UMask=0077

[Install]
WantedBy=spy-der.target
