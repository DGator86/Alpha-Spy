[Unit]
Description=Alpha-SPY prediction and decision engine
Wants=network-online.target alpha-spy-market.service alpha-spy-dashboard.service
After=network-online.target alpha-spy-market.service alpha-spy-dashboard.service
PartOf=alpha-spy.target

[Service]
Type=simple
User=alphaspy
Group=alphaspy
EnvironmentFile=-/etc/alpha-spy/secrets.env
ExecStart=/opt/alpha-spy/venv/bin/alpha-spy --config /etc/alpha-spy/config.yaml engine
Restart=always
RestartSec=5
Nice=-2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/alpha-spy /var/log/alpha-spy
UMask=0077

[Install]
WantedBy=alpha-spy.target
