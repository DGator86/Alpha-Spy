[Unit]
Description=Alpha-SPY nightly paper-validation and deterministic replay gates
After=alpha-spy.target alpha-spy-dojo.service

[Service]
Type=oneshot
User=alphaspy
Group=alphaspy
EnvironmentFile=-/etc/alpha-spy/secrets.env
ExecStart=/opt/alpha-spy/venv/bin/alpha-spy --config /etc/alpha-spy/config.yaml validate-promotion
# Gate failure exits nonzero by design; the report is still written and visible.
SuccessExitStatus=3
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/alpha-spy /var/log/alpha-spy
UMask=0077
