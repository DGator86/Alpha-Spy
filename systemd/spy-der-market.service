[Unit]
Description=SPY Constituent Alpha market collector
Wants=network-online.target
After=network-online.target
PartOf=spy-der.target

[Service]
Type=simple
User=spyder
Group=spyder
EnvironmentFile=-/etc/spy-der/secrets.env
ExecStart=/opt/spy-der/venv/bin/spy-der --config /etc/spy-der/config.yaml market
Restart=always
RestartSec=5
Nice=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/spy-der /var/log/spy-der
UMask=0077

[Install]
WantedBy=spy-der.target
