[Unit]
Description=Alpha-SPY T+15 confirmation and audit tape
Wants=alpha-spy-market.service
After=alpha-spy-market.service
PartOf=alpha-spy.target

[Service]
Type=simple
User=alphaspy
Group=alphaspy
EnvironmentFile=-/etc/alpha-spy/secrets.env
ExecStart=/opt/alpha-spy/venv/bin/alpha-spy --config /etc/alpha-spy/config.yaml confirmation
Restart=always
RestartSec=5
Nice=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/alpha-spy /var/log/alpha-spy
UMask=0077

[Install]
WantedBy=alpha-spy.target
