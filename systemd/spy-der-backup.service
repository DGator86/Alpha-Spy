[Unit]
Description=Back up SPY Constituent Alpha data to Google Drive
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=-/etc/spy-der/backup.env
ExecStart=/usr/local/sbin/spy-der-drive-backup
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUWeight=20
IOWeight=20
TimeoutStartSec=8h
