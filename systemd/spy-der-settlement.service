[Unit]
Description=SPY Constituent Alpha position monitor and settlement service
Wants=network-online.target spy-der-market.service
After=network-online.target spy-der-market.service
PartOf=spy-der.target

[Service]
Type=simple
User=spyder
Group=spyder
EnvironmentFile=-/etc/spy-der/secrets.env
ExecStart=/opt/spy-der/venv/bin/spy-der --config /etc/spy-der/config.yaml settlement
Restart=always
RestartSec=5
Nice=-1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/spy-der /var/log/spy-der
UMask=0077

[Install]
WantedBy=spy-der.target
