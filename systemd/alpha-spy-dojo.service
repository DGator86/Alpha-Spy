[Unit]
Description=Alpha-SPY nightly model governance report
After=alpha-spy.target

[Service]
Type=oneshot
User=alphaspy
Group=alphaspy
EnvironmentFile=-/etc/alpha-spy/secrets.env
ExecStart=/opt/alpha-spy/venv/bin/alpha-spy --config /etc/alpha-spy/config.yaml dojo --recent-days 20
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/alpha-spy /var/log/alpha-spy
UMask=0077
