[Unit]
Description=Back up Alpha-SPY data to Google Drive
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=-/etc/alpha-spy/backup.env
ExecStart=/usr/local/sbin/alpha-spy-backup
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUWeight=20
IOWeight=20
TimeoutStartSec=8h
